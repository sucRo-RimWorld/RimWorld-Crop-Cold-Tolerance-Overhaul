<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Plant_Rice -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="Plant_Rice"]/plant/minGrowthTemperature</xpath>
    <match Class="PatchOperationReplace">
      <xpath>/Defs/ThingDef[defName="Plant_Rice"]/plant/minGrowthTemperature</xpath>
      <value>
        <minGrowthTemperature>10</minGrowthTemperature>
      </value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef[defName="Plant_Rice"]/plant</xpath>
      <value>
        <minGrowthTemperature>10</minGrowthTemperature>
      </value>
    </nomatch>
  </Operation>

  <Operation Class="PatchOperationAddModExtension">
    <xpath>/Defs/ThingDef[defName="Plant_Rice"]</xpath>
    <value>
      <li Class="CropColdToleranceOverhaul.ColdToleranceExtension">
        <coldDeathTemperature>-1</coldDeathTemperature>
      </li>
    </value>
  </Operation>

